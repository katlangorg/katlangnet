# Derived from Eval_Distinguishes_HigherOrderAlgorithmContexts in EvaluatorTests.
# This benchmark deliberately measures one-hop receiver property lookup (dot chains of
# any depth are legal) and repeats that nested receiver path across distinct contexts.
Left = {
    Step = x + 1
    Value = Step(10)
}
Right = {
    Step = x + 2
    Value = Step(10)
}
Left.Value + Left.Value + Left.Value + Right.Value + Right.Value + Right.Value