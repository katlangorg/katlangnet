# KatLang parser fuzzing dictionary (libFuzzer format).
#
# Each entry is an optional name= followed by a double-quoted token. These are the
# lexical and syntactic fragments the mutator splices into inputs so it can reach
# grammar states that random bytes rarely hit (keywords, paired delimiters, operator
# spellings, and a few common definition/call/open shapes).

# ── Keywords ────────────────────────────────────────────────────────────────
kw_open="open"
kw_public="public"
kw_div="div"
kw_mod="mod"
kw_and="and"
kw_or="or"
kw_xor="xor"
kw_not="not"

# ── Operators & single punctuation ──────────────────────────────────────────
op_assign="="
op_eq="=="
op_neq="!="
op_le="<="
op_ge=">="
op_lt="<"
op_gt=">"
op_plus="+"
op_minus="-"
op_star="*"
op_slash="/"
op_caret="^"
op_comma=","
op_semicolon=";"
op_colon=":"
op_dot="."
op_tilde="~"
op_quote="'"
op_dquote="\""
op_comment="#"

# ── Delimiters, single and paired (incl. empty forms) ───────────────────────
lparen="("
rparen=")"
lbrace="{"
rbrace="}"
lbracket="["
rbracket="]"
empty_seq="()"
empty_brace="{}"
empty_list="[]"

# ── Common combined shapes ──────────────────────────────────────────────────
open_space="open "
public_space="public "
assign_spaced=" = "
call_open="f("
brace_call="f{"
dot_member=".map("
index_zero="[0]"
select_pair="[0, 1]"
retired_colon=":0"
collect_marker="(*"
collect_mid=", *"
spread_close="*)"
spread_comma="*, "
spread_chain="**"
spread_dot="*."
star_eol="*\x0a"
seq_pair="(1, 2)"
list_pair="[1, 2]"
clause_head="f(x) = "
cond_literal="(0) = "
string_lit="'x'"

# ── Rejected double quotes (STR-03): recovery boundaries ─────────────────────
# Double-quoted strings and string interpolation are NOT KatLang syntax. A double
# quote outside a comment or a single-quoted string is one lexical error, recovered
# as a run to the next double quote on its line (or to the end of the line). These
# seeds keep the malformed-input coverage of that rule: closed and unclosed runs,
# brace and backslash content, a run before a line break, and the positions where
# a rejected string must never become a module URL.
dq_empty="\"\""
dq_text="\"a\""
dq_brace_run="\"a{x}b\""
dq_unterminated="\"a"
dq_unterminated_brace="\"a{x"
dq_backslash_run="\"a\\\""
dq_before_newline="\"a\x0A"
dq_open_target="open \"u\""
dq_load_target="load(\"u\")"
dq_pattern="f(\"a\") = "
sq_holding_dquote="'a\"b'"
sq_holding_braces="'{x}'"
