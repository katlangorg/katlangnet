Program         = Algorithm ;

Algorithm       = { AlgorithmItem } ;
AlgorithmItem   = OpenDeclaration | PropertyDefinition | DeconstructionDefinition | ClauseDefinition | OutputLine ;

OpenDeclaration = "open" OpenTargetList ;
OpenTargetList  = OpenTarget { "," OpenTarget } ;
                  (* `open` is a declaration/import directive, not an output
                     expression: its target list is comma-separated only.
                     open A, B, C opens three targets; string targets use
                     single quotes (open 'url', A). Each algorithm allows at
                     most one open declaration. The first target must begin
                     on the same physical line as "open". Comma keeps its
                     normal explicit line-continuation behavior — open A,
                     newline B and open A newline , B both continue the
                     list — and a leading "." continues a dotted target
                     (open A newline .B is open A.B), but plain newline
                     adjacency never continues open: open Math newline
                     Math.Pi is an open plus a report row. ";" and same-line
                     adjacency are NOT open-target separators (open A ; B
                     and open A B report a missing-comma diagnostic).
                     A spread-marked open target (open A*) parses to a
                     spread expression and is rejected by open-form
                     validation: spread is not an open form. The parser
                     validates each target as an individual Lean-compatible
                     open form. *)
OpenTarget      = StringLiteral              (* sugar: open 'url' → open load('url') *)
                | Identifier                 (* resolve form *)
                | DottedOpenPath             (* argumentless dot-call path, e.g. Lib.Sub *)
                | ParenBundleExpr ;          (* parenthesized/block open target *)
DottedOpenPath  = Identifier { "." Identifier } ;

PropertyDefinition = [ "public" ] Identifier "=" PropertyBody ;
PropertyBody       = Algorithm ;

DeconstructionDefinition = CollectingBinding "=" OutputBundle
                         | BindingTarget ( "," BindingTarget )+ "=" OutputBundle ;
BindingTarget            = BindingIdentifier | CollectingBinding ;
CollectingBinding        = "*" BindingIdentifier ;
                     (* Prefix "*" is the COLLECT MARKER. A collecting binding
                        `*name` collects its matched supply segment into one
                        exact immutable list value (possibly zero items). The
                        marker must be DIRECTLY attached to its binding name:
                        no whitespace, comment, or newline may sit between the
                        star and the name (`* name` is a targeted attachment
                        error and never a collecting binding; `**name` is a
                        repeated-marker error). Comma binding pattern shared
                        by assignment binding and function parameter binding:
                        the right-hand side is matched against the targets
                        prefix/collecting/suffix — fixed targets bind from the
                        start and end, and at most one collecting target
                        `*name` collects the matched middle items. The
                        collecting target may appear at the start, middle, or
                        end. A plain `name = ...` stays an ordinary
                        PropertyDefinition; `*all = ...` is the unambiguous
                        lone-collecting-binding assignment form.
                        Assignment deconstruction is an unpacking receiver
                        (Python-style): a single sequence-valued OR
                        exact-list-valued right-hand side is unpacked into its
                        items (Result.structureItems?). So `x, *y, z = A` (A a
                        stored sequence value or exact list) unpacks A, and
                        `x, *y, z = A*` and `x, *y, z = 1, 2, 3, 4, 5` supply
                        the same items. This unpacking is assignment-specific
                        and does NOT change function calls, which still pass A
                        as one argument unless an explicit spread `A*` is
                        written. More than one collecting target is a parse
                        error. A function parameter list with a top-level
                        collecting parameter, e.g. F(x, *y, z), uses the
                        item-supply matcher over the supplied arguments (no
                        implicit opening); a single collecting parameter
                        F(*values) is the degenerate lone-collecting-binding
                        case. *)

ClauseDefinition = [ "public" ] Identifier "(" Pattern ")" "=" OutputBundle ;
                     (* Clause-style definition: Name(pattern) = body.
                        Recognized only in definition position;
                        in expression position Name(...) remains an ordinary call.
                        Public visibility is family-level: every clause in a
                        same-name family must either include `public` or omit it.
                        KatLang supports recursive parameter patterns in ordinary
                        algorithm definitions and conditional branch heads. A
                        same-name group with exactly one clause whose head consists
                        only of captures and structural sequence-value patterns elaborates as an
                        ordinary explicit parameter list, e.g. PairSum((x, y)) or
                        CountSequenceValue((*values)). A sequence-value parameter pattern
                        consumes one parent-level argument slot, so F((head,
                        *tail), suffix) takes one sequence-value first argument and
                        binds its immediate contents. Collecting bindings consume
                        sibling values at their own pattern-list level and collect
                        the assigned slots as one exact immutable list.
                        Multi-clause families and literal/mixed heads elaborate as
                        conditional algorithms. *)

Pattern            = PatternAtom { "," PatternAtom } ;
PatternAtom        = BindingIdentifier             (* fixed bind *)
                   | CollectingBinding            (* collecting bind `*name`; the ONLY
                                                      collecting-binding syntax. Valid only for
                                                      ordinary recursive explicit parameter
                                                      patterns, at most once per sibling pattern
                                                      level, and not with "~". Postfix `*` after
                                                      a binding name is spread syntax and is a
                                                      targeted error in a binding pattern. *)
                   | [ "-" ] NumberLiteral         (* litInt    *)
                   | StringLiteral                 (* litString *)
                   | "(" Pattern ")" ;             (* sequence-value pattern; always structural, even for singletons *)

OutputLine      = OutputBundle ;
OutputBundle    = ExpressionList ;

(* Canonical output shape:
      1. "," / adjacency — comma and allowed expression adjacency create a
               syntax-level expression list. Root output consumes a
               bare list as output slots, call syntax consumes it as
               argument slots, and parentheses materialize it as one
               sequence value. A spread expression (an attached postfix
               "*") stands as one whole slot and contributes its
               operand's items to the surrounding supply.
      2. ";"   — unsupported expression syntax. It reports a targeted
               semicolon diagnostic and recovers as an expression-list separator.
    The tricky cases this implies:
      F(1, 2, 3)      has three argument slots.
      F(1 2 3)        has three argument slots.
      F((1, 2, 3))    has one sequence-value argument.
      1, (2, 3)       has two output slots: 1 and sequence value (2, 3).
      A*, B, C        is spread-of-A, B, C.
      A* B            is the multiplication A * B (see the star rule below).
      A, B*           keeps B* local to its comma slot.
    Parsing is purely syntactic: callable arity, runtime values, and
      inferred types never change comma, parentheses, star, or spread
      behavior. *)

ExpressionList        = SequenceAtom { ExpressionListSeparator SequenceAtom } ;
ExpressionListSeparator = "," | ImplicitAdjacency ;
SequenceAtom          = Expression ;
                     (* A spread expression — a completed expression with a
                        DIRECTLY attached postfix "*" that has no valid
                        same-line right operand after it — is legal ONLY as a
                        whole expression-list slot, as the operand of another
                        spread (`value**`), or as the receiver of the fluent
                        dot continuation (`operand*.Target`, which lowers to
                        the lexical call `Target(operand*)`).
                        THE STAR RULE: when "*" has a valid same-line
                        expression-start token after it (identifier, number,
                        string, "(", "[", "{", "-", "not", "~"), it is infix
                        MULTIPLICATION regardless of spacing — `a*b`, `a* b`,
                        `a *b`, and `a * b` all multiply. Spreading before
                        another same-line supplied item therefore requires a
                        comma: `a*, b` is spread-then-item, because `a* b` is
                        multiplication. An attached line-final star is a
                        spread (`a*` newline `b` is a spread row and then a
                        `b` row); an unattached trailing star is
                        multiplication whose right operand continues on the
                        next physical line (`a *` newline `b`). A spread
                        expression contributes the items of one item-producing
                        boundary of the evaluated operand (sequence and list
                        values supply their contained items; an atom or string
                        supplies itself as one item) to the surrounding slot
                        context — it does not create a sequence or list value
                        by itself. Using a spread expression as an operand of
                        a unary or binary operator or an indexing target or
                        selector is a targeted parse error. Prefix "*" is
                        collect-marker (binding) syntax and is a targeted
                        error in expression position. *)
                     (* Semicolon is intentionally absent from ExpressionList.
                     `1 ; 2`, `A* ; B`, `P = 1 ; 2`, and `F(1 ; 2)`
                     all report the unsupported-semicolon diagnostic.
                     ImplicitAdjacency is not a token: a complete expression
                     followed by the start of another complete expression
                     implies an expression-list separator where adjacency is
                     allowed. Same-line whitespace adjacency: 1 2 parses like
                     1, 2, F(1 2) is the two-argument call F(1, 2), and (1 2)
                     is the sequence value (1, 2). In output contexts, a
                     physical newline between complete expressions implies the
                     same expression-list separation. A spread expression applies
                     only to its own operand: A, B* and A newline B*
                     parse as A, B*.
                     Definition bodies and open targets are
                     line-bounded instead: a newline ends a definition body
                     unless a leading-dot continuation carries it on, and ends an open target list unless an
                     explicit comma (trailing or leading) or a leading-dot
                     continuation carries it on (a "("- or "{"-led line
                     never continues either), so properties, clauses, and
                     opens on later lines keep their
                     declaration meaning. Implicit expression-list separation is
                     inserted only when the next token cannot legally continue
                     the current expression; a token that continues it as a
                     postfix/call form on the same physical line wins over adjacency. In
                     particular a "(" or "{" after a callable target on the
                     same physical line is a call delimiter even across
                     whitespace, so F (1, 2) is the call F(1, 2) and A.B (1)
                     is the dot call A.B(1). A physical newline never
                     continues a closed expression into a call: F newline
                     (1, 2) is the expression list F, (1, 2) and A.B newline (1)
                     is A.B, (1). For a multiline call, open the delimiter
                     before the newline — F( newline 1, 2 newline ) is the
                     call F(1, 2) — because an already-open argument list or
                     brace block spans lines normally. Explicit comma keeps
                     expression-list structure: F, (1) has two slots, and
                     F newline (1) also has two slots. The collect marker "*"
                     is prefix-only and must be directly attached to its
                     binding name; the spread marker "*" is postfix-only and
                     must be directly attached to its completed operand.
                     Adjacency
                     applies only between complete expressions: it never
                     splits identifiers or numbers, and a token sequence that
                     begins a property, clause, or open definition is
                     a definition, not an adjacent expression. A star never
                     participates in adjacency: it is multiplication, a
                     collect marker, or a spread marker. Physical line
                     boundaries are not structural groups, and parsing never
                     depends on callable arity. In an output context a physical
                     newline between complete expressions separates
                     expression-list slots; in a line-bounded definition body
                     it ends the body instead (see above).
                     THE PHYSICAL-LINE RULE in one sentence: a physical
                     newline ends a closed expression, and only a leading "."
                     (dot-chain continuation) or an
                     already-open "("/"{" delimiter may carry it across the
                     line — call delimiters, indexing ":", postfix grace "~",
                     the postfix spread marker "*", and binary operators all
                     require the same physical line (write a trailing
                     operator, e.g. A - newline 1, to continue arithmetic; an
                     attached trailing "*" is a spread, an unattached one is
                     multiplication continuing on the next line). Comments are
                     semantically invisible for these decisions: A newline -1
                     and A # note newline -1 parse identically as the expression
                     list A, -1, never the subtraction A - 1. *)

Expression      = OrExpr ;
                  (* Binary operators are same-physical-line only: an
                     operator at the start of a line never continues the
                     previous line's expression (a "-"-led line is a new
                     unary-minus output row). A trailing operator does
                     continue: A - newline 1 is the subtraction. Skipped
                     comments never relax this boundary. *)
OrExpr          = XorExpr { "or" XorExpr } ;
XorExpr         = AndExpr { "xor" AndExpr } ;
AndExpr         = EqualityExpr { "and" EqualityExpr } ;
EqualityExpr    = ComparisonExpr { ( "==" | "!=" ) ComparisonExpr } ;
ComparisonExpr  = AdditiveExpr { ( "<" | ">" | "<=" | ">=" ) AdditiveExpr } ;
AdditiveExpr    = MultiplicativeExpr { ( "+" | "-" ) MultiplicativeExpr } ;
MultiplicativeExpr
              = PowerExpr { ( "*" | "/" | "div" | "mod" ) PowerExpr } ;
                  (* The "*" alternative applies exactly when the star is NOT
                     a postfix spread marker: any same-line expression-start
                     token after the star selects multiplication regardless
                     of spacing, and an unattached star with no same-line
                     right operand is multiplication whose operand continues
                     on the next line. See SpreadExpression. *)
PowerExpr       = UnaryExpr [ "^" PowerExpr ] ;

UnaryExpr       = "-" UnaryExpr
                | "not" UnaryExpr
                | PostfixExpr ;

PostfixExpr     = Primary { PostfixOp } ;
PostfixOp       = ":" Primary   (* indexing is same-physical-line only: a ':'-led
                                   line never continues the previous expression and
                                   is a parse error. Same-line whitespace around ':'
                                   is insignificant (Pair:0, Pair :0, Pair : 0). *)
                | "." Identifier [ CallArgs ]
                                (* a '.'-led line intentionally continues the
                                   dot-call chain (method-chain layout). When
                                   the target of the "." is a spread
                                   expression, the continuation is the fluent
                                   supply transition: `operand*.Target(args)`
                                   lowers at parse time to the ordinary
                                   LEXICAL call `Target(operand*, args)` with
                                   the spread as the leading argument slot —
                                   the receiver is an item supply, not a
                                   value, so no structural member lookup
                                   applies and no property access happens on
                                   the spread. Further continuations chain on
                                   the call result
                                   (`x.Calculate*.Target.Other`). *)
                | SpreadMarker  (* see SpreadExpression *)
                | CallArgs ;    (* only when LHS is a callable target: Resolve, DotCall, or Grace,
                                   and only when the call delimiter is on the same physical
                                   line as the callable expression's last token. Same-line
                                   whitespace continues the call, so F (1, 2) is the call
                                   F(1, 2), and the same holds for dot-call argument lists and
                                   brace argument lists. A physical newline never continues a
                                   closed expression into a call: F newline (1, 2) is the
                                   expression list F, (1, 2). Multiline calls open the delimiter
                                   before the newline; the already-open argument list spans
                                   lines normally. Non-callable targets never become calls:
                                   2 (3) and 2 newline (3) are the expression list 2, 3, never
                                   multiplication. *)

SpreadMarker    = "*" ;
                  (* SpreadExpression ::= CompletedValueExpression "*".
                     Postfix "*" is the SPREAD MARKER. It forms a spread
                     expression exactly when (1) the star is DIRECTLY attached
                     to the completed expression's last token — exact
                     source-offset adjacency; whitespace, comments, and
                     newlines all break attachment — and (2) no valid
                     expression-start token follows the star on the star's own
                     physical line. Otherwise the star is infix multiplication
                     (see MultiplicativeExpr). A spread expression evaluates
                     its operand exactly once and contributes the operand's
                     items to the surrounding item supply (conceptually
                     spread : Value -> Supply; the RECEIVER decides what the
                     items become). It lowers directly to the one unary spread
                     node — there is no call or property boundary. Each
                     additional directly attached star nests one more unary
                     spread node (`value**` lowers to
                     SequenceSpread(SequenceSpread(value))), and evaluation
                     is compositional: `value**` means `(value*)*` — the
                     inner star's item supply is re-captured into one value
                     at the ordinary expression boundary before the outer
                     star spreads it. Repeated spread is not recursive
                     flattening. `value**next` and `value** next` are
                     rejected — the second star has a same-line right operand,
                     so it is multiplication whose left operand is a spread
                     (a targeted scalar-operand error); this is never
                     exponentiation. Examples: items*, Calculate(x)*,
                     x.Calculate*, (a + b)*, [1, 2]*, (1, 2)*, ()*, []*. *)

CallArgs        = BraceArgs | ParenArgs ;
BraceArgs       = "{" Algorithm "}" ;
ParenArgs       = "(" Algorithm ")" ;

Primary         = NumberLiteral
                | StringLiteral
                | GraceIdentifier
                | ParenBundleExpr
                | BraceAlgorithmExpr
                | ListLiteral ;

GraceIdentifier = { "~" } Identifier { "~" } ;
                  (* postfix "~" is same-physical-line only: a "~"-led line
                     is its own prefix-grace expression, never postfix grace
                     on the previous line's identifier. *)
ParenBundleExpr = "(" Algorithm ")" ;
                  (* Empty parentheses "()" construct the empty sequence value,
                     displayed as (). Ordinary repeated parentheses around the empty
                     sequence are redundant grouping and canonicalize to "()". Thus
                     "()", "(())", and "((()))" denote the same empty sequence value
                     in surface KatLang. Parentheses still create useful sequence
                     structure for multi-item expressions such as "(1, 2)" and
                     preserve meaningful nested non-empty sequence values such as
                     "(1, (2, 3))". By contrast "{}" is an empty no-output body
                     (BraceAlgorithmExpr), not a value. *)
BraceAlgorithmExpr = "{" Algorithm "}" ;
ListLiteral     = "[" [ ExpressionList ] "]" ;
                  (* Exact immutable list value, displayed as [1, 2, 3]. The
                     bracket content is a pure expression list — declarations
                     are not legal inside brackets — and spread elements insert
                     their item supply into the list being constructed
                     ([0, A*, 4]). UNLIKE ParenBundleExpr, no canonicalization
                     applies to list structure: "[]", "[7]", and "[[7]]" are
                     three distinct exact values ("[7]" never collapses to "7"
                     and "[]" is a different value from "()"). Ordinary
                     parentheses AROUND a list remain redundant sequence
                     grouping: "([1, 2])" is the same value as "[1, 2]".
                     "[" always begins a NEW expression: it is not a call or
                     indexing delimiter, so same-line "A[1]" is the adjacency
                     expression list "A, [1]" (indexing is ":"). An already-open
                     "[" spans physical lines exactly like "(" and "{" until
                     its "]" closes. A spread of a list opens exactly one list
                     boundary: "[1, 2, 3]*" supplies 1, 2, 3 and "[]*"
                     supplies zero items. *)

NumberLiteral   = Number ;
Number          = /\d(_*\d)*(\.\d(_*\d)*)?(e[+-]?\d(_*\d)*)?/ ;
BindingIdentifier = Identifier ;
Identifier      = /[A-Za-z_][A-Za-z0-9_]*/ ;
StringLiteral   = /'([^'\r\n])*'/ ;
Comment         = /#[^\r\n]*/ ;
                  (* a "#" outside a string literal starts a comment that runs
                     to the next physical newline or end of source; whitespace
                     before "#" is not required. Comments are semantically
                     invisible: they never extend or break a physical-line
                     continuation decision. *)
