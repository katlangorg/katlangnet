Program         = Algorithm ;
                  (* Unmatched root ")" and "}" are invalid syntax. Recovery
                     reports and skips each token, retaining later items in the
                     same root scope for editor analysis; the parse stays invalid. *)

Algorithm       = { AlgorithmItem } ;
AlgorithmItem   = OpenDeclaration | PropertyDefinition | DeconstructionDefinition | ClauseDefinition | OutputLine ;

ExpressionAlgorithm = { OutputLine } ;
                  (* Delimiter model: each delimiter has one role.
                     `( ... )` is sequence/expression grouping and
                     call-argument syntax (ParenBundleExpr, ParenArgs) and
                     parses this expression-only form; `[ ... ]` is list
                     construction; only `{ ... }` (BraceAlgorithmExpr,
                     BraceArgs) and the root Algorithm create an
                     algorithm-level lexical scope and own declarations.
                     A declaration written inside parentheses — an open
                     declaration, property/clause definition, or
                     deconstruction binding — is rejected with a targeted
                     parser diagnostic directing it to a `{ ... }` block.
                     Brace blocks work anywhere an expression-valued
                     algorithm is allowed, including as a call argument. *)

OpenDeclaration = "open" OpenTargetList ;
OpenTargetList  = OpenTarget { "," OpenTarget } ;
                  (* `open` is a declaration/import directive, not an output
                     expression: its target list is comma-separated only.
                     open A, B, C opens three targets; string targets use
                     single quotes (open 'url', A). Each algorithm allows at
                     most one open declaration. The first target must begin
                     on the same physical line as "open". Comma keeps its
                     normal explicit line-continuation behavior — open A,
                     newline B and open A newline , B both continue the
                     list — and a leading "." continues a dotted target
                     (open A newline .B is open A.B), but a plain newline
                     never continues open: open Math newline Math.Pi is an
                     open plus a report row. ";" and a bare same-line second
                     target are NOT open-target separators (open A ; B and
                     open A B report a missing-comma diagnostic).
                     A spread-marked open target (open A*) parses to a
                     spread expression and is rejected by open-form
                     validation: spread is not an open form. The parser
                     validates each target as an individual Lean-compatible
                     open form. *)
OpenTarget      = StringLiteral              (* sugar: open 'url' → open load('url') *)
                | ValidatedOpenExpression ;
ValidatedOpenExpression = ? an Expression not starting with a string token and satisfying the open-form constraints below ? ;
                  (* Open targets use the ordinary Expression parser, followed
                     by normalization and open-form validation. The resulting
                     outer node must be a bare resolve, a brace algorithm,
                     an argumentless dot-call, or a direct unresolved load
                     call (which requires asynchronous load elaboration).
                     Grace on an open path and call-like dot edges are rejected.
                     These are AST constraints, not a separate dotted-name
                     grammar: parentheses around a dotted expression, brace
                     algorithm, or load call normalize away, at every nesting
                     level. Thus open (M.N), open ((M.N)), open (M.N).P,
                     open ({ public X = 1 }), open ({ public N = {} }.N),
                     and open (load('url')) reach the same forms as their
                     ungrouped counterparts. A dot receiver still has to
                     resolve to an openable algorithm at evaluation time;
                     passing the outer-form check alone does not establish it
                     (e.g. open (M).N passes that parser check).
                     Bare names open directly, but open (M), open ((M)),
                     open (A, B), and open (A*) retain a captured VALUE and
                     receive the targeted BadOpenForm diagnostic. Empty groups,
                     literals, lists, and spread/supply forms are not open
                     forms, even if redundant grouping normalizes away:
                     open (()), open (1), open ('url'), open A*, and
                     open (A*.N) are rejected. String sugar applies only when
                     the target starts with the bare string token, which is
                     consumed alone: open 'url'.N is a target-list error,
                     while open ('url').N passes the outer dot-form check.
                     Declarations inside parentheses remain illegal; they
                     belong to brace algorithms. *)

PropertyDefinition = [ "public" ] Identifier "=" PropertyBody ;
PropertyBody       = OutputBundle ;

DeconstructionDefinition = CollectingBinding "=" OutputBundle
                         | BindingTarget ( "," BindingTarget )+ "=" OutputBundle ;
BindingTarget            = BindingIdentifier | CollectingBinding ;
CollectingBinding        = "*" BindingIdentifier ;
                     (* Prefix "*" is the COLLECT MARKER. A collecting binding
                        `*name` collects its matched supply segment into one
                        exact immutable list value (possibly zero items). The
                        marker must be DIRECTLY attached to its binding name:
                        no whitespace, comment, or newline may sit between the
                        star and the name (`* name` is a targeted attachment
                        error and never a collecting binding; `**name` is a
                        repeated-marker error). Comma binding pattern shared
                        by assignment binding and function parameter binding:
                        the right-hand side is matched against the targets
                        prefix/collecting/suffix — fixed targets bind from the
                        start and end, and at most one collecting target
                        `*name` collects the matched middle items. The
                        collecting target may appear at the start, middle, or
                        end. A plain `name = ...` stays an ordinary
                        PropertyDefinition; `*all = ...` is the unambiguous
                        lone-collecting-binding assignment form.
                        Assignment deconstruction is an unpacking receiver
                        (Python-style): a single sequence-valued OR
                        exact-list-valued right-hand side is unpacked into its
                        items (Result.structureItems?). So `x, *y, z = A` (A a
                        stored sequence value or exact list) unpacks A, and
                        `x, *y, z = A*` and `x, *y, z = 1, 2, 3, 4, 5` supply
                        the same items. This unpacking is assignment-specific
                        and does NOT change function calls, which still pass A
                        as one argument unless an explicit spread `A*` is
                        written. More than one collecting target is a parse
                        error. A function parameter list with a top-level
                        collecting parameter, e.g. F(x, *y, z), uses the
                        item-supply matcher over the supplied arguments (no
                        implicit opening); a single collecting parameter
                        F(*values) is the degenerate lone-collecting-binding
                        case. *)

ClauseDefinition = [ "public" ] Identifier "(" Pattern ")" "=" OutputBundle ;
                     (* Clause-style definition: Name(pattern) = body.
                        Recognized only in definition position;
                        in expression position Name(...) remains an ordinary call.
                        Public visibility is family-level: every clause in a
                        same-name family must either include `public` or omit it.
                        KatLang supports recursive parameter patterns in ordinary
                        algorithm definitions and conditional branch heads. A
                        same-name group with exactly one clause whose head consists
                        only of captures and structural sequence-value patterns elaborates as an
                        ordinary explicit parameter list, e.g. PairSum((x, y)) or
                        CountSequenceValue((*values)). A sequence-value parameter pattern
                        consumes one parent-level argument slot, so F((head,
                        *tail), suffix) takes one sequence-value first argument and
                        binds its immediate contents. Collecting bindings consume
                        sibling values at their own pattern-list level and collect
                        the assigned slots as one exact immutable list.
                        Multi-clause families and literal/mixed heads elaborate as
                        conditional algorithms. *)

Pattern            = PatternAtom { "," PatternAtom } ;
PatternAtom        = BindingIdentifier             (* fixed bind *)
                   | CollectingBinding            (* collecting bind `*name`; the ONLY
                                                      collecting-binding syntax. Valid only for
                                                      ordinary recursive explicit parameter
                                                      patterns, at most once per sibling pattern
                                                      level, and not with "~". Postfix `*` after
                                                      a binding name is spread syntax and is a
                                                      targeted error in a binding pattern. *)
                   | [ "-" ] NumberLiteral         (* litInt    *)
                   | StringLiteral                 (* litString *)
                   | "(" Pattern ")" ;             (* sequence-value pattern; always structural, even for singletons *)

OutputLine      = OutputBundle ;
OutputBundle    = ExpressionList ;

(* Canonical output shape:
      1. ","     — the explicit slot separator of an expression list. Root
               output consumes a bare list as output slots, call syntax
               consumes it as argument slots, and parentheses materialize
               it as one sequence value. A spread expression (an attached
               postfix "*") stands as one whole slot and contributes its
               operand's items to the surrounding supply.
      2. newline — a PHYSICAL LINE BREAK between two closed expressions
               separates slots in the contexts that stay open across
               lines (root output, brace bodies, parenthesized groups,
               call argument lists, list literals); it ENDS a definition
               body and an open target list instead. It is not a token:
               the parser reads line numbers from the tokens (see the
               layout rules below).
      3. ";"     — unsupported expression syntax. It reports a targeted
               semicolon diagnostic and recovers as a slot separator.
    Whitespace NEVER separates slots (SYN-07A, September 2026): a second
      closed expression on the same physical line without a comma is the
      targeted parse error UnseparatedSameLineItem, recovered as the next
      slot of the same list.
    The tricky cases this implies:
      F(1, 2, 3)      has three argument slots.
      F(1 2 3)        is rejected (one separator diagnostic per missing
                      comma), recovering as three argument slots.
      F((1, 2, 3))    has one sequence-value argument.
      1, (2, 3)       has two output slots: 1 and sequence value (2, 3).
      A*, B, C        is spread-of-A, B, C.
      A* B            is the multiplication A * B (see the star rule below).
      A, B*           keeps B* local to its comma slot.
      A B*            is rejected: a same-line slot before a spread needs
                      the comma like every other slot.
    Parsing is purely syntactic: callable arity, runtime values, and
      inferred types never change comma, parentheses, star, or spread
      behavior. *)

ExpressionList        = SequenceAtom { ExpressionListSeparator SequenceAtom } ;
ExpressionListSeparator = "," | PhysicalNewline ;
                     (* PhysicalNewline is not a token: it stands for "the
                        next slot begins on a later physical line", and it
                        is admitted only in the multiline expression-list
                        contexts named above (a definition body ends at
                        the newline instead). There is NO whitespace
                        separator: two slots on one line need ",". *)
SequenceAtom          = Expression ;
                     (* A spread expression — a completed expression followed
                        on the same physical line by a postfix "*" that no
                        valid right operand follows — is legal ONLY as a
                        whole expression-list slot, as the operand of another
                        spread (`value**`), or as the receiver of the fluent
                        dot continuation (`operand*.Target`, which lowers to
                        the lexical call `Target(operand*)`).
                        THE STAR RULE (SYN-07B, layout-independent): the next
                        significant token after the star decides, never
                        whitespace and never the physical newline. When an
                        expression-start token follows (identifier, number,
                        string, "(", "[", "{", "-", "not", "~") — on the same
                        line or on a later one — the star is infix
                        MULTIPLICATION: `a*b`, `a* b`, `a *b`, `a * b`,
                        `a*` newline `b`, and `a *` newline `b` all multiply.
                        The one exception is a following DECLARATION head
                        (`Name = ...`, `Name(pattern) = ...`, a binding
                        pattern `x, *y = ...`, `open`, `public`, `~Name = ...`):
                        a declaration head is never an operand, so `a*`
                        newline `b = 1` is a spread row followed by a
                        definition — the same declaration-starter relation the
                        slot boundary stops at. Spreading before another
                        supplied item therefore requires a comma: `a*, b` is
                        spread-then-item, and the trailing comma keeps the
                        list open across a line (`a*,` newline `b`), because
                        `a* b` and `a*` newline `b` are multiplication. The
                        star is the spread marker when the surrounding syntax
                        closes the expression before any operand could follow:
                        a comma, a closing ")", "]", or "}", end of input, a
                        token that cannot start an expression (".", ";", "==",
                        ...), or a declaration head. THE MARKER ATTACHMENT
                        LAW then applies to that spread marker, as to every
                        structural/annotation marker (`*name`, `name*`,
                        `~name`, `name~`): it must be DIRECTLY attached to
                        the expression it spreads. A detached `values *` that
                        no operand follows is a targeted parse error
                        (InvalidSpreadMarker) — never silently a spread and
                        never silently a multiplication — so whitespace can
                        separate the valid `values*` from the rejected
                        `values *`, but can never turn one valid operation
                        into another. A spread
                        expression contributes the items of one item-producing
                        boundary of the evaluated operand (sequence and list
                        values supply their contained items; an atom or string
                        supplies itself as one item) to the surrounding slot
                        context — it does not create a sequence or list value
                        by itself. Using a spread expression as an operand of
                        a unary or binary operator or an indexing target or
                        selector is a targeted parse error. Prefix "*" is
                        collect-marker (binding) syntax and is a targeted
                        error in expression position. *)
                     (* Semicolon is intentionally absent from ExpressionList.
                     `1 ; 2`, `A* ; B`, `P = 1 ; 2`, and `F(1 ; 2)`
                     all report the unsupported-semicolon diagnostic.
                     THE SEPARATOR RULE (SYN-07A): two slots on the same
                     physical line are separated by an explicit ",". A
                     complete expression followed on the same physical line by the
                     start of another complete expression is the targeted
                     parse error UnseparatedSameLineItem — 1 2, F(1 2),
                     (1 2), [1 2], 2(3), A[1], 2m, sqrt 2, and P = a b are
                     all rejected — and recovers as the next slot of the
                     SAME list (the arguments of F(1 2) stay two arguments;
                     the body of P = a b keeps both slots and leaks nothing
                     into the enclosing scope). Parameter-pattern lists
                     (clause heads and nested sequence-value patterns) follow
                     the same rule: F(a b) = a + b, F(1 2) = 3, F((a b)) = a,
                     and F(a, *b c) = a are the same UnseparatedSameLineItem
                     error, worded for patterns (the comma is the only
                     repair), reported once at the unseparated item and
                     recovered as the next pattern of the SAME head (F(a, b)
                     = a + b), so the head's ")" and "=" are found where
                     written; a pattern on a later line without a comma is
                     not admitted (parameter lists have no newline separator)
                     and keeps the closing-delimiter diagnostic. In the multiline contexts
                     (root output, brace bodies, parenthesized groups, call
                     argument lists, list literals) a physical newline
                     between complete expressions separates slots without a
                     comma. A spread expression applies only to its own
                     operand: A, B* and A newline B* parse as A, B*, while
                     A B* is rejected like every other same-line pair.
                     Definition bodies and open targets are
                     line-bounded instead: a newline before a new independent
                     expression ends a definition body. A comma, an already-open
                     delimiter, a trailing operator, or a leading dot may
                     continue that body. A newline ends an open target list unless an
                     explicit comma (trailing or leading) or a leading-dot
                     continuation carries it on (a "("- or "{"-led line
                     never continues either), so properties, clauses, and
                     opens on later lines keep their
                     declaration meaning. A slot boundary is considered only
                     when the next token cannot legally continue the current
                     expression; a token that continues it as a postfix/call
                     form on the same physical line continues it. In
                     particular a "(" or "{" after a callable target on the
                     same physical line is a call delimiter even across
                     whitespace, so F (1, 2) is the call F(1, 2) and A.B (1)
                     is the dot call A.B(1), and a same-line binary operator
                     continues arithmetic, so F(1 -2) is the one argument
                     1 - 2 (write F(1, -2) for two). A physical newline never
                     continues a closed expression into a call: F newline
                     (1, 2) is the expression list F, (1, 2) and A.B newline (1)
                     is A.B, (1). For a multiline call, open the delimiter
                     before the newline — F( newline 1, 2 newline ) is the
                     call F(1, 2) — because an already-open argument list or
                     brace block spans lines normally. Explicit comma keeps
                     expression-list structure: F, (1) has two slots, and
                     F newline (1) also has two slots. The collect marker "*"
                     is prefix-only and must be directly attached to its
                     binding name; the spread marker "*" is postfix-only,
                     is classified by the token after it (see the star rule
                     above), and must then be directly attached to its
                     completed operand.
                     THE DECLARATION-ROW RULE (SYN-07A): a declaration — open,
                     a property or clause definition, a deconstruction
                     binding pattern, or a public declaration — begins a
                     physical line, or is the first item directly after the
                     "{" that opens a brace body. A declaration head after
                     other content on the same line (1 P = 3, x = 3 y = 4,
                     { x = 1 y = 2 }) is the same UnseparatedSameLineItem
                     error, recovered as the declaration it spells. In
                     { d = 2 n * d }, the missing separator before n instead
                     recovers n * d as another slot inside d's body. A token
                     sequence that begins a property, clause, or open
                     definition is a definition, never a slot; whitespace
                     never splits identifiers or numbers. A star never
                     participates in slot separation: it is multiplication,
                     a collect marker, or a spread marker. Physical line
                     boundaries are not structural groups, and parsing never
                     depends on callable arity. In an output context a physical
                     newline between complete expressions separates
                     expression-list slots; in a line-bounded definition body
                     it ends the body instead (see above).
                     THE PHYSICAL-LINE RULE in one sentence: a physical
                     newline ends a closed expression, and only a leading "."
                     (dot-chain continuation) or an
                     already-open "("/"{" delimiter may carry it across the
                     line — call delimiters, indexing ":", postfix grace "~",
                     the postfix spread marker "*", and binary operators all
                     require the same physical line (write a trailing
                     operator, e.g. A - newline 1, to continue arithmetic; a
                     trailing "*", spaced or not, is multiplication continuing
                     on the next line whenever an operand starts that line,
                     and otherwise a spread marker that must be attached:
                     `A*` spreads, `A *` is rejected). Comments are
                     semantically invisible for these decisions: A newline -1
                     and A # note newline -1 parse identically as the expression
                     list A, -1, never the subtraction A - 1. *)

Expression      = OrExpr ;
                  (* Binary operators are same-physical-line only: an
                     operator at the start of a line never continues the
                     previous line's expression (a "-"-led line is a new
                     unary-minus output row). A trailing operator does
                     continue: A - newline 1 is the subtraction. Skipped
                     comments never relax this boundary. *)
OrExpr          = XorExpr { "or" XorExpr } ;
XorExpr         = AndExpr { "xor" AndExpr } ;
AndExpr         = EqualityExpr { "and" EqualityExpr } ;
EqualityExpr    = ComparisonExpr { ( "==" | "!=" ) ComparisonExpr } ;
ComparisonExpr  = AdditiveExpr { ( "<" | ">" | "<=" | ">=" ) AdditiveExpr } ;
AdditiveExpr    = MultiplicativeExpr { ( "+" | "-" ) MultiplicativeExpr } ;
MultiplicativeExpr
              = UnaryExpr { ( "*" | "/" | "div" | "mod" ) UnaryExpr } ;
                  (* The "*" alternative applies exactly when the star is NOT
                     a postfix spread marker: an expression-start token after
                     the star that does not begin a declaration selects
                     multiplication regardless of spacing and regardless of an
                     intervening newline (the right operand may start the next
                     physical line, as for every trailing binary operator).
                     See SpreadExpression. *)

UnaryExpr       = "-" UnaryExpr
                | "not" UnaryExpr
                | PowerExpr ;

PowerExpr       = PostfixExpr [ "^" UnaryExpr ] ;
                  (* "^" binds tighter than the prefix unary operators on the
                     LEFT only: the base is a PostfixExpr, so -2 ^ 2 parses
                     as -(2 ^ 2) and a negative base needs parentheses,
                     (-2) ^ 2. The exponent re-enters UnaryExpr, so unary
                     exponents stay valid (2 ^ -2) and "^" stays
                     right-associative (2 ^ 3 ^ 2 is 2 ^ (3 ^ 2), because a
                     UnaryExpr exponent ends in another PowerExpr). Like the
                     binary operators, "^" continues a closed expression on
                     the same physical line only: a trailing "^" continues to
                     its right operand on the next line, a "^"-led line never
                     continues the previous expression. *)

PostfixExpr     = Primary { PostfixOp } ;
PostfixOp       = ":" Primary   (* indexing is same-physical-line only: a ':'-led
                                   line never continues the previous expression and
                                   is a parse error. Same-line whitespace around ':'
                                   is insignificant (Pair:0, Pair :0, Pair : 0). *)
                | "." { "~" } Identifier [ CallArgs ]
                                (* a '.'-led line intentionally continues the
                                   dot-call chain (method-chain layout).
                                   GRACE COMPOSES WITH DOT. `recv~.Name` is
                                   ordinary postfix Grace on the bare receiver
                                   name followed by an ordinary dot; `recv.~Name`
                                   is ordinary dot with prefix Grace on the
                                   member/fallback name occurrence. Repeated
                                   markers use the normal same-occurrence
                                   weight arithmetic (`recv~~.Name`,
                                   `recv.~~Name`). Parameter detection consumes
                                   Grace, so every form builds the SAME ordinary
                                   dot edge as `recv.Name`: structural member
                                   first, lexical fallback second.

                                   Free-name collection follows semantic source order:
                                   receiver, participating member fallback,
                                   then arguments, so `K = a.t(b)` infers
                                   `(a, t, b)`. Thus `a.t` infers `(a, t)`;
                                   postfix Grace in `a~.t` moves `a` one place
                                   later, and prefix Grace in `a.~t` moves `t`
                                   one place earlier, so both infer `(t, a)`.
                                   The multi-argument forms both infer
                                   `(t, a, b, c)` from base `(a, t, b, c)`.
                                   Runtime fallback invocation as `t(a, b)`
                                   does not determine signature order.

                                   Grace itself remains restricted to one bare
                                   name occurrence. Therefore postfix Grace on
                                   a literal, group, call result, dot result
                                   (including the second `~.` in `a~.t~.u`),
                                   list, brace, string, or spread is a targeted
                                   error that recovers as the graceless edge.
                                   Prefix member Grace is eligible even with a
                                   compound receiver because it decorates the
                                   bare member/fallback name, not the receiver.
                                   Call arguments are unrestricted.
                                   The marker attachment law applies: postfix
                                   Grace is directly attached to the receiver
                                   name (`a~.t`, or `a~ .t` — the space before
                                   the same-line dot is ordinary), while a
                                   detached `a ~ .t` / `a ~.t` is a targeted
                                   parse error that recovers as the graceless
                                   edge `a.t` (order `(a, t)`). Postfix Grace is
                                   same-physical-line only. A cross-line chain
                                   uses the '.'-led continuation; prefix member
                                   Grace must be directly attached after that
                                   dot AND to the member name (`a.~t`; `a.~ t`
                                   is the attachment error).
                                   A grace-marked
                                   open target is rejected (`open M~.C`).
                                   When the target of the "." is a spread
                                   expression, the continuation is the fluent
                                   supply transition: `operand*.Target(args)`
                                   lowers at parse time to the ordinary
                                   LEXICAL call `Target(operand*, args)` with
                                   the spread as the leading argument slot —
                                   the receiver is an item supply, not a
                                   value, so no structural member lookup
                                   applies and no property access happens on
                                   the spread. Postfix Grace on the spread is
                                   invalid; prefix member Grace in
                                   `operand*.~Target` decorates the ordinary
                                   lowered lexical callee occurrence. Further
                                   continuations chain on the call result
                                   (`x.Calculate*.Target.Other`). *)
                | SpreadMarker  (* see SpreadExpression *)
                | CallArgs ;    (* only when LHS is a callable target: Resolve, DotCall, or Grace,
                                   and only when the call delimiter is on the same physical
                                   line as the callable expression's last token. Same-line
                                   whitespace continues the call, so F (1, 2) is the call
                                   F(1, 2), and the same holds for dot-call argument lists and
                                   brace argument lists. A physical newline never continues a
                                   closed expression into a call: F newline (1, 2) is the
                                   expression list F, (1, 2). Multiline calls open the delimiter
                                   before the newline; the already-open argument list spans
                                   lines normally. Non-callable targets never become calls:
                                   2 (3) and 2 newline (3) are the expression list 2, 3, never
                                   multiplication. *)

SpreadMarker    = "*" ;
                  (* SpreadExpression ::= CompletedValueExpression "*".
                     Postfix "*" is the SPREAD MARKER. It forms a spread
                     expression exactly when (1) the star is on the same
                     physical line as the completed expression's last token,
                     (2) no valid right operand follows the star — the next
                     significant token, on ANY line, either cannot start an
                     expression or begins a declaration — and (3) the star is
                     DIRECTLY attached to that last token (exact source-offset
                     adjacency; the marker attachment law). A star that (2)
                     rules out is infix multiplication (see
                     MultiplicativeExpr) however it is spaced — a physical
                     newline after the star never decides; a star that (2)
                     admits but (3) rejects (`value *` with nothing to
                     multiply) is a targeted parse error, InvalidSpreadMarker,
                     that recovers to the operand alone. A spread expression evaluates
                     its operand exactly once and contributes the operand's
                     items to the surrounding item supply (conceptually
                     spread : Value -> Supply; the RECEIVER decides what the
                     items become). It lowers directly to the one unary spread
                     node — there is no call or property boundary. Each
                     additional directly attached star nests one more unary
                     spread node (`value**` lowers to
                     SequenceSpread(SequenceSpread(value))), and evaluation
                     is compositional: `value**` means `(value*)*` — the
                     inner star's item supply is re-captured into one value
                     at the ordinary expression boundary before the outer
                     star spreads it. Repeated spread is not recursive
                     flattening. `value**next`, `value** next`, and
                     `value**` newline `next` are rejected — the second star
                     has a right operand, so it is multiplication whose left
                     operand is a spread (a targeted scalar-operand error);
                     this is never exponentiation. Examples: items*, Calculate(x)*,
                     x.Calculate*, (a + b)*, [1, 2]*, (1, 2)*, ()*, []*. *)

CallArgs        = BraceArgs | ParenArgs ;
                  (* An argument list is purely syntactic: the grammar admits
                     ANY number of argument slots for ANY callee, and no
                     production is conditioned on the callee's spelling.
                     Builtin names are ordinary Identifiers (see Identifier)
                     that a nearer declaration may shadow, so which callable a
                     call denotes — and therefore how many arguments it
                     accepts — is settled by name resolution and checked
                     against that callable's signature during evaluation, not
                     here. `if(1, 2)` and `count(1, 2, 3)` are both well-formed
                     syntax and both evaluation-time arity errors. *)
BraceArgs       = "{" Algorithm "}" ;
ParenArgs       = "(" ExpressionAlgorithm ")" ;

Primary         = NumberLiteral
                | StringLiteral
                | GraceIdentifier
                | ParenBundleExpr
                | BraceAlgorithmExpr
                | ListLiteral ;

GraceIdentifier = { "~" } Identifier { "~" } ;
                  (* Grace `~` applies ONLY to one bare parameter/name
                     occurrence — this production is its entire surface, and
                     it is written WITHOUT whitespace: every marker is
                     directly attached to the identifier or to its
                     neighbouring marker (`~x`, `x~`, `~~x`, `~x~`). The
                     marker attachment law makes a detached marker (`~ x`,
                     `x ~`, `~ ~x`) a targeted parse error (InvalidGraceMarker)
                     that recovers to the plain identifier with no weight —
                     never silently reordered, never silently ignored.
                     A marker run attached to any other completed
                     expression (`(x + y)~`, `f(x)~`, `x.y~`, `[x]~`, `5~`,
                     `~(x)`) is a targeted parse error spanning the run:
                     Grace is a parameter-order annotation, not an
                     expression operator, and never distributes through a
                     compound operand. That rejection is the same at the end
                     of a line (`f(x)~` newline `a`) and before a same-line
                     operand (`f(x)~ c`); a prefix-grace slot after another
                     slot on one line needs a comma (`f(x), ~c`). The whole
                     marker run is physical-line-local and the identifier it
                     decorates must be on the run's own line: a "~"-led line
                     is its own prefix-grace expression, never postfix grace
                     on the previous line's identifier, and a run ending a
                     line never becomes prefix grace on the next line's
                     identifier (`~` newline `~a` reports the first line's
                     lone marker and keeps `~a` intact). *)
ParenBundleExpr = "(" ExpressionAlgorithm ")" ;
                  (* Empty parentheses "()" construct the empty sequence value,
                     displayed as (). Ordinary repeated parentheses around the empty
                     sequence are redundant grouping and canonicalize to "()". Thus
                     "()", "(())", and "((()))" denote the same empty sequence value
                     in surface KatLang. Parentheses still create useful sequence
                     structure for multi-item expressions such as "(1, 2)" and
                     preserve meaningful nested non-empty sequence values such as
                     "(1, (2, 3))". By contrast "{}" is an empty no-output body
                     (BraceAlgorithmExpr), not a value. *)
BraceAlgorithmExpr = "{" Algorithm "}" ;
ListLiteral     = "[" [ ExpressionList ] "]" ;
                  (* Exact immutable list value, displayed as [1, 2, 3]. The
                     bracket content is a pure expression list — declarations
                     are not legal inside brackets — and spread elements insert
                     their item supply into the list being constructed
                     ([0, A*, 4]). UNLIKE ParenBundleExpr, no canonicalization
                     applies to list structure: "[]", "[7]", and "[[7]]" are
                     three distinct exact values ("[7]" never collapses to "7"
                     and "[]" is a different value from "()"). Ordinary
                     parentheses AROUND a list remain redundant sequence
                     grouping: "([1, 2])" is the same value as "[1, 2]".
                     "[" always begins a NEW expression: it is not a call or
                     indexing delimiter, so same-line "A[1]" is a second item
                     after "A" and is rejected by the separator rule (indexing
                     is ":"; "A, [1]" is the two-slot list). An already-open
                     "[" spans physical lines exactly like "(" and "{" until
                     its "]" closes. A spread of a list opens exactly one list
                     boundary: "[1, 2, 3]*" supplies 1, 2, 3 and "[]*"
                     supplies zero items. *)

NumberLiteral   = Number ;
Number          = /[0-9](_*[0-9])*(\.[0-9](_*[0-9])*)?(e[+-]?[0-9](_*[0-9])*)?/ ;
                  (* Values are IEEE 754 Decimal128: source text parses directly
                     into the 34-significant-digit representation. A finite
                     literal with more significant digits rounds to nearest
                     (round-half-even); a literal whose magnitude exceeds the
                     Decimal128 range (beyond about 9.999e6144) is rejected with
                     the number-too-large diagnostic. This production describes
                     VALID numeric syntax and is deliberately ASCII-only. During
                     recovery from invalid input, the lexer also enters its
                     number-scanning path for any Unicode decimal digit (Nd, per
                     UTF-16 code unit); text such as U+0663 is then rejected by
                     Decimal128 parsing with the number-too-large diagnostic.
                     That recovery behavior is not admitted by this production
                     and is pinned separately by Utf16LexerContractTests. *)
BindingIdentifier = Identifier ;
Identifier      = IdentifierStart { IdentifierPart } ;
                  (* An Identifier is a maximal identifier-shaped word that is
                     not a ReservedWord: the lexer scans the longest run of
                     identifier characters and then classifies the whole word,
                     so every ReservedWord spelling lexes as its keyword token
                     and is never a valid identifier, while any other word —
                     including builtin names such as "if" or "sum" — is an
                     ordinary Identifier. Identifier characters are Unicode
                     classes evaluated PER UTF-16 CODE UNIT (the classes of
                     System.Char.IsLetter / System.Char.IsDigit): letters of
                     any script work (Greek U+03C0, Cyrillic, CJK, precomposed
                     accented letters such as U+00E9), but recognition never
                     pairs surrogates — a supplementary-plane letter written
                     as a surrogate pair (e.g. U+1D400) is NOT an identifier
                     character — and combining marks are not identifier
                     characters either (decomposed "e" + U+0301 is the
                     identifier "e" followed by an unexpected-character
                     diagnostic). Source text is never Unicode-normalized. A
                     Unicode decimal digit may CONTINUE an identifier but
                     never STARTS one, because the Number production claims a
                     leading digit first. These identifier and reserved-word
                     terminal claims are mechanically pinned against the
                     shipped lexer by EbnfLexicalSyncTests. *)
IdentifierStart = "_" | UnicodeLetter ;
IdentifierPart  = "_" | UnicodeLetter | UnicodeDigit ;
UnicodeLetter   = ? a UTF-16 code unit in Unicode category Lu, Ll, Lt, Lm, or Lo (System.Char.IsLetter) ? ;
UnicodeDigit    = ? a UTF-16 code unit in Unicode category Nd (System.Char.IsDigit) ? ;
ReservedWord    = "div" | "mod" | "and" | "or" | "xor" | "not" | "public" | "open" ;
                  (* The complete reserved-word list; each spelling is a
                     distinct keyword token, never an Identifier. Reservation
                     is exact and case-sensitive: "Open", "Div", and "NOT" are
                     ordinary identifiers. *)
StringLiteral   = /'([^'\r\n])*'/ ;
Comment         = /#[^\r\n]*/ ;
                  (* a "#" outside a string literal starts a comment that runs
                     to the next physical newline or end of source; whitespace
                     before "#" is not required. Comments are semantically
                     invisible: they never extend or break a physical-line
                     continuation decision. *)
