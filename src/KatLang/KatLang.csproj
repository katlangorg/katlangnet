<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>KatLang</RootNamespace>

		<PackageId>KatLang</PackageId>
		<Version>0.8.151</Version>
		<Authors>katlangorg</Authors>
		<Company>Logics Research Centre SIA</Company>
		<Copyright>Copyright © Logics Research Centre SIA and contributors</Copyright>

		<Description>KatLang is a domain-specific programming language for calculations. This package provides the core parser, evaluator, and semantic model.</Description>
		<PackageTitle>KatLang</PackageTitle>
		<PackageTags>katlang;dsl;calculations;mathematics;physics</PackageTags>

		<PackageProjectUrl>https://katlang.org</PackageProjectUrl>
		<RepositoryUrl>https://github.com/katlangorg/katlangnet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<PackageReleaseNotes>Breaking syntax and terminology redesign for collection and spreading. Source migration: `items...` becomes `*items`, and both `spread(items)` and `items.spread` become `items*`. There are no compatibility aliases, and `spread` is an ordinary identifier with no reserved meaning. The star now has three purely syntactic roles: prefix `*` is the collect marker in binding patterns (`*items` declares a collecting binding; in a parameter list it is a collecting parameter), postfix `*` directly attached to a completed expression is the spread marker (`value*` contributes the value's items to the surrounding item supply), and every other star is multiplication. A star with a same-line right operand multiplies regardless of spacing, so `a* b` is `a * b` — write `a*, b` to spread before another same-line item. Chained spread is `value**`, and the fluent chain `x.Calculate*.Target` lowers to `Target(x.Calculate*)`. Canonical terminology: "collecting parameter" is the construct name; "variadic" now only describes a callable that accepts a variable number of argument items. Public API: ParameterKind.Variadic→Collecting, CollectingMarkerSpan→CollectMarkerSpan, SequenceSpread.IntrinsicNameSpan→SpreadMarkerSpan, PropertyParameterInfo.IsVariadic→IsCollecting, AstWalker.VisitCollectingBindingMarker→VisitCollectMarker, the ParameterPattern/CallableSignature/CallableBindingPlan variadic members→Collecting*, and TokenKind.Ellipsis was removed. Semantics (capture/collect/spread, exact lists, one-boundary spread) are unchanged and remain Lean-aligned.</PackageReleaseNotes>

		<Title>KatLang</Title>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KatLang.Tests" />
		<InternalsVisibleTo Include="KatLang.Benchmarks" />
		<!-- Grants the standalone parser fuzzing harness (fuzz/KatLang.ParserFuzz)
		     access to the internal Parser.ParseSyntax raw-syntax entry point.
		     Compile-time friend access only; does not change any public API. -->
		<InternalsVisibleTo Include="KatLang.ParserFuzz" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\NOTICE">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\PATENTS">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
