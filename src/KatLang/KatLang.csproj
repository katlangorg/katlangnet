<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>KatLang</RootNamespace>

		<PackageId>KatLang</PackageId>
		<Version>0.8.141</Version>
		<Authors>katlangorg</Authors>
		<Company>Logics Research Centre SIA</Company>
		<Copyright>Copyright © Logics Research Centre SIA and contributors</Copyright>

		<Description>KatLang is a domain-specific programming language for calculations. This package provides the core parser, evaluator, and semantic model.</Description>
		<PackageTitle>KatLang</PackageTitle>
		<PackageTags>katlang;dsl;calculations;mathematics;physics</PackageTags>

		<PackageProjectUrl>https://katlang.org</PackageProjectUrl>
		<RepositoryUrl>https://github.com/katlangorg/katlangnet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<PackageReleaseNotes>Core formalized in Lean 4. Algorithms separated from Results domain. Shifted to ownership-first resolution. Redesigned algorithm opening mechanism and other improvements. Compatibility note for semantic-AST consumers: an undocumented C#-only strict-variadic suffix reshape of manually constructed lone Expr.SequenceConstruct builtin arguments was removed; KatLang source programs are unaffected, and externally constructed nodes now follow the ordinary grouped-value argument path, aligned with the Lean model (see docs/design/sequence-boundary-audit-2026-07.md section 7).</PackageReleaseNotes>

		<Title>KatLang</Title>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KatLang.Tests" />
		<InternalsVisibleTo Include="KatLang.Benchmarks" />
		<!-- Grants the standalone parser fuzzing harness (fuzz/KatLang.ParserFuzz)
		     access to the internal Parser.ParseSyntax raw-syntax entry point.
		     Compile-time friend access only; does not change any public API. -->
		<InternalsVisibleTo Include="KatLang.ParserFuzz" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\NOTICE">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\PATENTS">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
