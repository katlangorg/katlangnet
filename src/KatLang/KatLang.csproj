<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>KatLang</RootNamespace>

		<PackageId>KatLang</PackageId>
		<Version>0.8.163</Version>
		<Authors>katlangorg</Authors>
		<Company>Logics Research Centre SIA</Company>
		<Copyright>Copyright © Logics Research Centre SIA and contributors</Copyright>

		<Description>KatLang is a domain-specific programming language for calculations. This package provides the core parser, evaluator, and semantic model.</Description>
		<PackageTitle>KatLang</PackageTitle>
		<PackageTags>katlang;dsl;calculations;mathematics;physics</PackageTags>

		<PackageProjectUrl>https://katlang.org</PackageProjectUrl>
		<RepositoryUrl>https://github.com/katlangorg/katlangnet</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<PackageReleaseNotes>Corrects DotCall fallback participation and Grace composition across the parser, elaborator, evaluator, editor model, optimizer gates, Lean model, tests, and documentation. Ordinary dotted calls remain structural-first with ordinary lexical fallback. `a~.t(args)` is ordinary postfix Grace on receiver name `a` followed by ordinary dot; `a.~t(args)` is ordinary prefix Grace on the participating fallback/member occurrence `t`. Both elaborate to the same DotCall body as `a.t(args)`, while the two-name inferred order is `(t, a)` instead of ordinary `(a, t)`. A may-selected fallback participates at semantic source position (receiver, member/fallback, arguments), independently of runtime fallback invocation order. Grace remains restricted to one bare name occurrence and affects only inferred parameter ordering. Removes the provisional runtime-extension public surface shipped in 0.8.159 (`DotResolutionMode`, `Expr.DotCall.ResolutionMode`, `Expr.DotCall.ExtensionMarkerSpan`, `DotCallContext.IsExtension`, and `AstWalker.VisitExtensionDotMarker`) and the later `Expr.Grace.IsExtensionReceiver` provenance flag; this is an intentional source/binary compatibility correction because those members represented semantic state that no longer exists.</PackageReleaseNotes>

		<Title>KatLang</Title>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KatLang.Tests" />
		<InternalsVisibleTo Include="KatLang.Benchmarks" />
		<!-- Grants the standalone parser fuzzing harness (fuzz/KatLang.ParserFuzz)
		     access to the internal Parser.ParseSyntax raw-syntax entry point.
		     Compile-time friend access only; does not change any public API. -->
		<InternalsVisibleTo Include="KatLang.ParserFuzz" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\NOTICE">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\PATENTS">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
