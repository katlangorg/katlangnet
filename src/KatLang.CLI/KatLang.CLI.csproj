<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The single authoritative KatLang version; see KatLangVersion.props. The CLI
    is the command-line distribution of the KatLang runtime it carries, so this
    assembly's version IS that runtime's version, and both come from there.
  -->
  <Import Project="..\..\KatLangVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <Version>$(KatLangVersion)</Version>
    <Description>Command-line interface for the KatLang language.</Description>

	<Company>Logics Research Centre SIA</Company>
	<Copyright>Copyright © Logics Research Centre SIA and Contributors</Copyright>
	<Product>KatLang</Product>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!--
    .NET 11 preview 7's osx-x64 libSystem.Net.Security.Native.a contains an
    under-aligned pointer atom that chained fixups reject. Remove this after
    upgrading to a runtime pack where dotnet/runtime#129601 is resolved.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <LinkerArg Include="-Wl,-no_fixup_chains" />
  </ItemGroup>

  <Target Name="RenameKatLangPublishedExecutable" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)KatLang.CLI.exe" DestinationFiles="$(PublishDir)katlang.exe" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) AND Exists('$(PublishDir)KatLang.CLI.exe')" />
    <Move SourceFiles="$(PublishDir)KatLang.CLI" DestinationFiles="$(PublishDir)katlang" Condition="($([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))) AND Exists('$(PublishDir)KatLang.CLI')" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="KatLang.CLI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      KatLang is the integration boundary: the CLI is a thin consumer of its
      PUBLIC API and contains no language semantics. That stays true across the
      project reference because KatLang.CLI is deliberately absent from
      KatLang's InternalsVisibleTo list, so reaching for an internal would be a
      compile error until someone adds it there in a reviewable change.
    -->
    <ProjectReference Include="..\KatLang\KatLang.csproj" />
  </ItemGroup>

</Project>
