    "source": "# Define a property:\nAnswer = 42\n\n# Property-style access:\nAnswer\n\n# Explicit zero-parameter call:\nAnswer()",
    "outcome": "Evaluates",
    "displayChecks": [
      {
        "text": "42\n42"
      }
