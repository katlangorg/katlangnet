        "expectedNeutral": "ok raw=true n=1"
      },
      {
        "source": "first('abc') == 'abc'[0]",
        "expectedNeutral": "ok raw=true n=1"
      },
      {
        "source": "true[0]",
        "expectedNeutral": "ok raw=true n=1"
      },
      {
        "source": "count([])",
        "expectedNeutral": "ok raw=0 n=1"
      },
      {
        "source": "[][0]",
        "expectedNeutral": "err index"
