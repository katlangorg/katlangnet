<Project Sdk="Microsoft.NET.Sdk">

  <!-- The single authoritative KatLang version; see KatLangVersion.props. -->
  <Import Project="..\..\KatLangVersion.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The version this build INTENDS to ship, baked into the test assembly at
    compile time. It is what the CLI version test compares the running CLI's
    reported version against, and it deliberately does NOT come from the loaded
    KatLang assembly: the assertion is "what the build intended" vs "what the
    process actually loaded", so a stale KatLang.dll or a PackageReference that
    resolved to an older package still fails. Deriving the expectation from the
    runtime would make that comparison self-fulfilling.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="IntendedKatLangVersion" Value="$(KatLangVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Only the CLI is referenced. The KatLang package arrives transitively, which
    keeps the tests honest about the integration boundary: they exercise the CLI
    against exactly the published API surface the CLI itself consumes.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\KatLang.CLI\KatLang.CLI.csproj" />
  </ItemGroup>

</Project>
