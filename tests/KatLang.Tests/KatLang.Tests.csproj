<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KatLang\KatLang.csproj" />
  </ItemGroup>

  <!--
    The metamorphic fuzzing core is compiled into this test assembly as SHARED SOURCE rather
    than referenced as a project. fuzz/KatLang.ParserFuzz is deliberately outside KatLang.slnx
    (and depends on SharpFuzz), while MetamorphicFuzzHarnessTests must exercise exactly the
    decoder, template, executor, comparator, and replay driver the campaign runs — a second
    copy would let fuzzing and replay drift apart. Only the self-contained Metamorphic folder
    is shared; the rest of the harness stays out of normal validation.
  -->
  <ItemGroup>
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\Metamorphic\*.cs"
             Link="Metamorphic\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>