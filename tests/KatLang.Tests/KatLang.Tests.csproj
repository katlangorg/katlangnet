<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Shared test infrastructure (repo root, artifact regeneration contract); see Infrastructure/. -->
    <Using Include="KatLang.TestInfrastructure" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KatLang\KatLang.csproj" />
  </ItemGroup>

  <!--
    The metamorphic fuzzing core is compiled into this test assembly as SHARED SOURCE rather
    than referenced as a project. fuzz/KatLang.ParserFuzz is deliberately outside KatLang.slnx
    (and depends on SharpFuzz), while MetamorphicFuzzHarnessTests must exercise exactly the
    decoder, template, executor, comparator, and replay driver the campaign runs — a second
    copy would let fuzzing and replay drift apart. Only the self-contained Metamorphic folder
    is shared; the rest of the harness stays out of normal validation.
  -->
  <ItemGroup>
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\Metamorphic\*.cs" Link="Metamorphic\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The UTF-16 target is shared the same way and for the same reason: its tests must exercise the
    exact decoder, builder, executor, relations and replay driver the campaign runs. It also needs
    the four harness files it reuses instead of reimplementing — the shared span validator (whose
    line/column model is the one contract every layer checks against), the raw-parser invariants,
    the frontend invariants, and the structural fingerprint. All of them are SharpFuzz-free.
  -->
  <ItemGroup>
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\Utf16\*.cs" Link="Utf16\%(Filename)%(Extension)" />
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\SourceSpanValidator.cs" Link="Utf16\SourceSpanValidator.cs" />
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\FuzzInvariants.cs" Link="Utf16\FuzzInvariants.cs" />
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\FrontEndInvariants.cs" Link="Utf16\FrontEndInvariants.cs" />
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\FrontEndFingerprint.cs" Link="Utf16\FrontEndFingerprint.cs" />
  </ItemGroup>

  <!--
    The Phase 7 editor-tooling target is shared the same way and for the same reason: its tests must
    exercise the exact decoder, builder, cursor/edit model, oracle, executor, relations and replay
    driver the campaign runs. It reuses the UTF-16 code-unit tables and the shared span validator
    already included above, so nothing here is re-included.
  -->
  <ItemGroup>
    <Compile Include="..\..\fuzz\KatLang.ParserFuzz\Editor\*.cs" Link="Editor\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>