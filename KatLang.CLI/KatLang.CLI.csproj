<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <KatLangVersion>0.8.179</KatLangVersion>
    <Version>$(KatLangVersion)</Version>
    <Description>Command-line interface for the KatLang language.</Description>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <Target Name="RenameKatLangPublishedExecutable" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)KatLang.CLI.exe" DestinationFiles="$(PublishDir)katlang.exe"
		  Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) AND Exists('$(PublishDir)KatLang.CLI.exe')" />
	<Exec
	  Command="powershell -NoProfile -NonInteractive -Command &quot;Compress-Archive -LiteralPath '$(PublishDir)katlang.exe' -DestinationPath '$(PublishDir)katlang-cli-$(Version)-$(RuntimeIdentifier).zip' -CompressionLevel Optimal -Force&quot;"
	  Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) AND Exists('$(PublishDir)katlang.exe')" />
	<Move
      SourceFiles="$(PublishDir)KatLang.CLI"
      DestinationFiles="$(PublishDir)katlang"
      Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) AND Exists('$(PublishDir)KatLang.CLI')" />
	<Exec
	  Command="tar --format=ustar --owner=0 --group=0 --numeric-owner --mode=0755 -czf &quot;$(PublishDir)katlang-cli-$(Version)-$(RuntimeIdentifier).tar.gz&quot; -C &quot;$(PublishDir)&quot; katlang"
	  Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) AND Exists('$(PublishDir)katlang')" />
  </Target>

  <ItemGroup>
    <!--
      The published KatLang package IS the integration boundary: the CLI is a
      thin consumer of its public API and contains no language semantics.
    -->
    <PackageReference Include="KatLang" Version="$(KatLangVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KatLang.CLI.Tests" />
  </ItemGroup>

</Project>
