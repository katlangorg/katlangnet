<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <KatLangVersion>0.8.179</KatLangVersion>
    <Version>$(KatLangVersion)</Version>
    <Description>Command-line interface for the KatLang language.</Description>
  </PropertyGroup>

  <Target Name="RenameKatLangPublishedExecutable" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)KatLang.CLI.exe" DestinationFiles="$(PublishDir)katlang.exe"
		  Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) AND Exists('$(PublishDir)KatLang.CLI.exe')" />
	<Move
      SourceFiles="$(PublishDir)KatLang.CLI"
      DestinationFiles="$(PublishDir)katlang"
      Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) AND Exists('$(PublishDir)KatLang.CLI')" />
  </Target>

  <ItemGroup>
    <!--
      The published KatLang package IS the integration boundary: the CLI is a
      thin consumer of its public API and contains no language semantics.
    -->
    <PackageReference Include="KatLang" Version="$(KatLangVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KatLang.CLI.Tests" />
  </ItemGroup>

</Project>
