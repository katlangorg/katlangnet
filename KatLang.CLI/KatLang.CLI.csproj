<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The single authoritative KatLang version; see KatLangVersion.props. The CLI
    is the command-line distribution of the KatLang runtime it carries, so this
    assembly's version IS that runtime's version, and both come from there.
  -->
  <Import Project="..\KatLangVersion.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <Version>$(KatLangVersion)</Version>
    <Description>Command-line interface for the KatLang language.</Description>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference>Speed</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <Target Name="RenameKatLangPublishedExecutable" AfterTargets="Publish">
    <Move SourceFiles="$(PublishDir)KatLang.CLI.exe" DestinationFiles="$(PublishDir)katlang.exe" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) AND Exists('$(PublishDir)KatLang.CLI.exe')" />
	<Exec Command="powershell -NoProfile -NonInteractive -Command &quot;Compress-Archive -LiteralPath '$(PublishDir)katlang.exe' -DestinationPath '$(PublishDir)katlang-cli-$(Version)-$(RuntimeIdentifier).zip' -CompressionLevel Optimal -Force&quot;" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) AND Exists('$(PublishDir)katlang.exe')" />
	<Move SourceFiles="$(PublishDir)KatLang.CLI" DestinationFiles="$(PublishDir)katlang" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) AND Exists('$(PublishDir)KatLang.CLI')" />
	<Exec Command="tar --format=ustar --owner=0 --group=0 --numeric-owner --mode=0755 -czf &quot;$(PublishDir)katlang-cli-$(Version)-$(RuntimeIdentifier).tar.gz&quot; -C &quot;$(PublishDir)&quot; katlang" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')) AND Exists('$(PublishDir)katlang')" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="KatLang.CLI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      KatLang is the integration boundary: the CLI is a thin consumer of its
      PUBLIC API and contains no language semantics. That stays true across the
      project reference because KatLang.CLI is deliberately absent from
      KatLang's InternalsVisibleTo list, so reaching for an internal would be a
      compile error until someone adds it there in a reviewable change.
    -->
    <ProjectReference Include="..\src\KatLang\KatLang.csproj" />
  </ItemGroup>

</Project>
